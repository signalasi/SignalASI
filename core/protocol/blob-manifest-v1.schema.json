{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GalaxySSI ciphertext Blob manifest v1",
  "description": "Public relay metadata. Contains no plaintext file hash, filename, identity, key, MIME type or conversation content. Runtime also validates full-size non-final chunks and the total size.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "chunks"],
  "properties": {
    "version": {"const": 1},
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "size"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 16, "maximum": 1048592}
        }
      }
    }
  }
}
